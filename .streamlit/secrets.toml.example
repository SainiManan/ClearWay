# Streamlit secrets, used ONLY if you have an OpenRouteService API key.
#
# Copy this file to .streamlit/secrets.toml and fill in the key. The real file
# is git-ignored. On Streamlit Community Cloud, add the key in the app's
# Settings > Secrets panel instead of committing it to the repository.
#
# Without a key the app falls back to the keyless OpenStreetMap community
# routing service, which works locally but refuses connections from cloud
# hosts. See "Deployment" in README.md.

# OPENROUTESERVICE_API_KEY = "your-key-here"
